# ==============================================================================
# EntryDesk Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
# Use the POOLED Neon endpoint (contains "-pooler." in the hostname).
# The pooled endpoint uses PgBouncer — critical for Vercel serverless stability.
# Example: postgresql://user:pass@ep-cool-scene-b3gb17ai-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@YOUR_POOLED_NEON_HOST/YOUR_DATABASE?sslmode=require

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Obtain from: https://console.cloud.google.com -> APIs & Services -> Credentials
# Add your production domain AND localhost:PORT to Authorized JavaScript Origins.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Application Base URL ─────────────────────────────────────────────────────
# CRITICAL: Used for all generated links, QR codes in ID cards, and email links.
# In production this MUST be your real domain (https://yourdomain.com).
# NEVER use http://localhost in production or QR codes will point to localhost.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Email / OTP (Resend) ─────────────────────────────────────────────────────
# Required for parent Email OTP login fallback and status-change notification emails.
# Sign up free at https://resend.com — free tier: 100 emails/day, 3,000/month.
# For production with 500+ parents, upgrade to Pro ($20/mo = 50,000 emails/mo).
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_FROM=EntryDesk <noreply@yourdomain.com>

# ─── Vercel Blob (Photo Storage) ──────────────────────────────────────────────
# Required for athlete photo uploads (used on ID cards and dashboards).
# Create a Blob store in your Vercel project: Dashboard -> Storage -> Create -> Blob.
# The token will be auto-injected into your Vercel environment after linking.
# For local development, copy the token from your Vercel project settings.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_TOKEN

# ─── Cloudflare Turnstile CAPTCHA ─────────────────────────────────────────────
# Optional — protects the public /contact form from bots.
# Obtain from: https://dash.cloudflare.com -> Turnstile
# Local testing dummy keys (always pass):
#   Site Key: 1x00000000000000000000AA
#   Secret Key: 1x0000000000000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
